RPC_URL=https://sepolia.infura.io/v3/你的KEY
# 角色（SPEC 第 10 节，三个私钥对应地址必须两两不同）：
#   PRIVATE_KEY           发布者：注册技能、请求审计并锁押金
#   AUDITOR_PRIVATE_KEY   审计者运营方：python -m auditor.stake 质押
#   OWNER_PRIVATE_KEY     管理员：部署合约、slashAuditor 裁决争议
PRIVATE_KEY=0x发布者钱包私钥（勿用主钱包）
AUDITOR_PRIVATE_KEY=0x第二个测试钱包私钥
OWNER_PRIVATE_KEY=0x第三个测试钱包私钥（管理员/合约 owner）
# 常驻 Agent 必需，模型须支持 Chat Completions function tool calling
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
